; Clean up the per-user Explorer context-menu entries and the startup entry on uninstall.
!macro customUnInstall
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.jpg\shell\Tangerine"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.jpeg\shell\Tangerine"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.png\shell\Tangerine"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.webp\shell\Tangerine"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.heic\shell\Tangerine"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.heif\shell\Tangerine"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.tif\shell\Tangerine"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.tiff\shell\Tangerine"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.gif\shell\Tangerine"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.bmp\shell\Tangerine"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.svg\shell\Tangerine"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.mp4\shell\Tangerine"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.mov\shell\Tangerine"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.avi\shell\Tangerine"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.mkv\shell\Tangerine"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.webm\shell\Tangerine"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.m4v\shell\Tangerine"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.mp3\shell\Tangerine"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.wav\shell\Tangerine"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.aac\shell\Tangerine"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.flac\shell\Tangerine"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.ogg\shell\Tangerine"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.m4a\shell\Tangerine"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.opus\shell\Tangerine"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.pdf\shell\Tangerine"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.docx\shell\Tangerine"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.doc\shell\Tangerine"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.txt\shell\Tangerine"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.rtf\shell\Tangerine"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.md\shell\Tangerine"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.markdown\shell\Tangerine"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.odt\shell\Tangerine"
  DeleteRegValue HKCU "Software\Microsoft\Windows\CurrentVersion\Run" "com.tangerine.windows"
!macroend
